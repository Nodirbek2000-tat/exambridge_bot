# Shu faylni nusxa qilib .env deb saqlang va qiymatlarni to'ldiring:
#   cp .env.dist .env

# @BotFather bergan token
BOT_TOKEN=123456789:AAAA-bu-yerga-token

# Adminlarning Telegram ID'lari, vergul bilan (o'z ID'ingizni @userinfobot dan bilib olasiz)
ADMINS=123456789

# Sayt bilan aloqa. Saytdagi .env dagi TELEGRAM_BOT_API_SECRET bilan AYNAN bir xil bo'lsin.
BOT_API_SECRET=bu-yerga-uzun-tasodifiy-kalit

# Serverda o'zgartirmang: bot sayt bilan bitta Docker tarmog'ida ishlaydi.
BACKEND_URL=http://web:8000
BACKEND_HOST=exambridge.uz
SITE_URL=https://exambridge.uz
SUPPORT_USERNAME=nodirbek_shukurov1
